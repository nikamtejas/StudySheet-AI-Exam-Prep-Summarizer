# Copy to .env.local and fill in. See docs/studysheet-build-prompt.md §14.
# Nothing here is secret except RENDER_TOKEN_SECRET — NEXT_PUBLIC_* is shipped
# to the browser in plain text.

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side only, verifies /print render tokens. Not required until M6.
RENDER_TOKEN_SECRET=
