# Copy to .env.local and fill in for real deploys. The value below is a
# local-dev-only dummy (matches backend/.env.example's), safe to commit —
# see docs/studysheet-build-prompt.md §14.

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side only, verifies /print render tokens (M6). Must match
# backend/.env's RENDER_TOKEN_SECRET exactly. Change this for real deploys.
RENDER_TOKEN_SECRET=dev-render-token-secret-change-me
