# Copy to .env and fill in. See docs/studysheet-build-prompt.md §14.

NODE_ENV=development
PORT=4000
WORKER_HEALTH_PORT=4100

FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Required. Point these at the docker-compose stack for local dev.
MONGODB_URI=mongodb://localhost:27017/studysheet
REDIS_URL=redis://localhost:6379

# Required. Local dev points at the MinIO stand-in from docker-compose.yml,
# not real Cloudflare R2 — hence S3_ENDPOINT / S3_FORCE_PATH_STYLE below.
R2_ACCOUNT_ID=studysheet-local
R2_ACCESS_KEY_ID=studysheet
R2_SECRET_ACCESS_KEY=studysheet-dev
R2_BUCKET=studysheet-dev
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# Required. Any non-empty value works for local dev; use a real secret in production.
AUTH_SECRET=dev-auth-secret-change-me
RENDER_TOKEN_SECRET=dev-render-token-secret-change-me
COOKIE_DOMAIN=localhost

# Optional until M2 wires up real Claude calls.
ANTHROPIC_API_KEY=

# Optional until M8 wires up real sign-in. Without EMAIL_SERVER, magic links
# are logged to the console instead of sent (see backend/src/lib/auth.ts).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_SERVER=
EMAIL_FROM=StudySheet <no-reply@studysheet.local>

# Optional until M10 wires up billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

MAX_PAGES_PER_JOB=200
MAX_FILE_MB=32
FREE_TIER_PAGES=30
COST_GUARD_CENTS=250
SOLVE_VERIFICATION=on
SOLVE_MAX_PER_JOB=40
WORKER_CONCURRENCY=4
PUPPETEER_POOL_SIZE=2
