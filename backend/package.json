{
  "name": "studysheet-backend",
  "version": "0.1.0",
  "private": true,
  "description": "StudySheet API + worker (Express + BullMQ)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "npm run sync:contracts",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/worker/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "sync:contracts": "node scripts/sync-contracts.mjs",
    "probe": "tsx src/cli/probe.ts",
    "summarize": "tsx src/cli/summarize.ts",
    "eval:solve": "tsx src/cli/eval-solve.ts",
    "fixtures:generate": "node fixtures/generate.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "bullmq": "^5.34.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "franc-min": "^6.2.0",
    "ioredis": "^5.4.2",
    "mathjs": "^15.2.0",
    "mongoose": "^8.9.0",
    "pdfjs-dist": "^4.10.38",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "sharp": "^0.35.3",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "pdf-lib": "^1.17.1",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
